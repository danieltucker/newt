generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id @default(cuid())
  username      String            @unique
  email         String?           @unique
  passwordHash  String
  isAdmin       Boolean           @default(false)
  bannedAt      DateTime?
  firstName     String?
  lastName      String?
  avatar        String?
  settings      Json              @default("{}")
  totpSecret        String?
  totpPendingSecret String?
  totpEnabled       Boolean           @default(false)
  // Bearer secret for this user's personal aggregate blog feed. It travels in a
  // URL (/api/v1/blogs/feed/<token>.xml), so it is never exposed for any user
  // but the owner, and can be rotated to revoke a leaked link.
  feedToken     String?           @unique
  createdAt     DateTime          @default(now())
  folders       Folder[]
  readingFolders ReadingFolder[]
  folderFeeds   FolderFeed[]
  blogPosts     BlogPost[]
  bookmarks     Bookmark[]
  readingList   ReadingListItem[]
  refreshTokens RefreshToken[]
  dismissedFeedItems DismissedFeedItem[]
  readFeedItems      ReadFeedItem[]
  comments           Comment[]
  friendshipsRequested Friendship[]  @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]  @relation("FriendshipAddressee")
  notifications        Notification[]
  notificationsActed   Notification[] @relation("NotificationActor")
  images               Image[]
  adminActions         AdminAction[] @relation("AdminActionActor")
  blocksMade           Block[]       @relation("BlockBlocker")
  blocksReceived       Block[]       @relation("BlockBlocked")
  reportsFiled         Report[]      @relation("ReportReporter")
  reportsAgainst       Report[]      @relation("ReportSubject")
  reportsResolved      Report[]      @relation("ReportResolver")
}

// One person's decision to have nothing more to do with another. The row is
// directed — it records who did the blocking, which is what the Blocked list and
// the unblock button need — but it is *enforced* symmetrically: every gate reads
// it from both sides via blockWallOf() in lib/blocks.ts, so a single row makes
// the two users mutually invisible.
//
// Blocking is not a weaker friendship. Creating one deletes any Friendship row
// between the pair in the same transaction, so the two states can never disagree
// and friendIdsOf() needs no block-awareness of its own.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// A user-filed report about a comment, a post, or a person, addressed to the
// moderators. Three properties follow from the fact that a report outlives what
// it describes — the usual outcome of a valid report is that the content is
// deleted:
//
//  1. `targetId` has no foreign key, and `snapshot` carries the content as it
//     read when reported. A moderator must be able to judge a report after the
//     author has edited or deleted the evidence, so the report keeps its own
//     copy rather than joining to a live row.
//
//  2. Both user columns are nullable with denormalised usernames beside them.
//     Deleting an account must not erase the reports filed against it, nor the
//     record of who raised them.
//
//  3. `status` moves open → resolved | dismissed and never back. Rows are never
//     deleted; a handled report stays readable, which is the only way to see
//     that the same person has been reported five times before.
model Report {
  id               String    @id @default(cuid())

  reporterId       String?
  reporter         User?     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterUsername String

  // Who the report is *about* — the author of the reported content, or the
  // reported user themselves. Denormalised so a repeat-offender count survives
  // account deletion.
  subjectId        String?
  subject          User?     @relation("ReportSubject", fields: [subjectId], references: [id], onDelete: SetNull)
  subjectUsername  String

  targetType       String    // 'comment' | 'blogPost' | 'user'
  targetId         String
  targetLabel      String    // human-readable identity, captured at report time
  targetUrl        String?   // where the content lives, for the moderator to open

  // The reported content as it stood when reported: sanitized HTML for a comment
  // or post, empty for a user report.
  snapshot         String    @default("")

  // One of REPORT_CATEGORIES in lib/reports.ts
  category         String
  note             String    @default("")   // the reporter's own words

  status           String    @default("open")  // 'open' | 'resolved' | 'dismissed'
  resolvedById     String?
  resolvedBy       User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedByUsername String?
  resolutionNote   String?
  resolvedAt       DateTime?

  createdAt        DateTime  @default(now())

  // One open report per person per thing — re-reporting the same comment is a
  // no-op rather than a way to flood the queue.
  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([subjectId, createdAt])
  @@index([targetType, targetId])
}

// A friend relationship, created as a directed request and confirmed when the
// addressee accepts. The pair is unordered once accepted — friendIdsOf() reads
// it from either side. A declined request or an unfriend simply deletes the row.
model Friendship {
  id          String    @id @default(cuid())
  requesterId String
  requester   User      @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User      @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // 'pending' | 'accepted'
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// Recipient-scoped, generic notification. `actor` is whoever triggered it; the
// article* / commentId columns carry context for the comment-activity types.
// commentId is a plain string (no FK) so deleting a comment can't cascade here.
model Notification {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   // 'friend_request' | 'friend_accept' | 'comment_reply' | 'friend_comment' | 'report_new'
  actorId      String?
  actor        User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  articleKey   String?
  articleUrl   String?
  articleTitle String?
  commentId    String?
  // Set on 'report_new' only: which report in the moderation queue this alert
  // is about, so the bell can open it directly. A plain string for the same
  // reason commentId is — a notification must not hold a row hostage, and a
  // report that is somehow gone should leave a dead link, not a failed delete.
  reportId     String?
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Folder {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  color             String
  position          Int
  feedLastCheckedAt DateTime?
  backgroundImage   String?
  bookmarks         Bookmark[]
  feeds             FolderFeed[]
  dismissedFeedItems DismissedFeedItem[]
  createdAt         DateTime      @default(now())

  @@index([userId])
}

// One feed subscribed to inside a folder. This replaced a bare
// Folder.feedUrls String[]: a row of its own is what lets a subscription carry
// a user-set name, be re-pointed at a different URL, and move between folders
// while staying the same subscription. The Feed itself (and its items) is still
// shared across every user — this is only the per-user reference to it.
model FolderFeed {
  id        String   @id @default(cuid())
  folderId  String
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  // Denormalised from the folder so ownership checks don't need a join, the
  // same way Bookmark carries it.
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  // User-set display name. "" means "derive it" — the matching bookmark's name,
  // then the feed's own title, then the hostname.
  name      String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  // A folder subscribes to a given URL once. Note this is the literal URL, not
  // canonicalFeedKey: two spellings of one feed dedupe at the Feed level, and
  // blocking them here would reject a legitimate re-point to a moved URL.
  @@unique([folderId, url])
  @@index([userId])
  @@index([folderId])
}

// Feeds and their items are shared across all users — one fetch per feed
// regardless of how many folders/users reference it. canonicalKey normalises
// scheme/www/trailing-slash so URL permutations map to the same feed.
model Feed {
  id            String     @id @default(cuid())
  canonicalKey  String     @unique
  fetchUrl      String
  title         String     @default("")
  lastCheckedAt DateTime?
  // Conditional-GET validators from the last successful fetch. Sent back as
  // If-None-Match / If-Modified-Since so an unchanged feed answers 304 with no
  // body and no re-upsert.
  etag          String?
  lastModified  String?
  // Last time a user actually requested this feed (opened its folder, checked a
  // bookmark). The background scheduler only refreshes feeds demanded recently,
  // so feeds nobody looks at go dormant and stop costing outbound requests.
  lastRequestedAt DateTime?
  items         FeedItem[]

  @@index([lastCheckedAt])
}

model FeedItem {
  id         String    @id @default(cuid())
  feedId     String
  feed       Feed      @relation(fields: [feedId], references: [id], onDelete: Cascade)
  link       String
  // Canonical form of link — lets an article be found from any URL spelling,
  // the same key comments are threaded on
  linkKey    String?
  title      String
  pubDate    DateTime?
  fetchedAt  DateTime  @default(now())
  readTime   Int?
  snippet    String?
  // Full article HTML from the feed, sanitized on write. Backfills on the next
  // refresh for items stored before this column existed.
  content    String?
  imageUrl   String?
  categories String[]  @default([])
  dismissals DismissedFeedItem[]
  reads      ReadFeedItem[]

  @@unique([feedId, link])
  @@index([feedId])
  @@index([linkKey])
}

// Per-user, per-folder state on shared items (dismissed / saved-away)
model DismissedFeedItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId  String
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  itemId    String
  item      FeedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, folderId, itemId])
  @@index([folderId, userId])
}

// Read state is per-user but NOT per-folder: an item you scrolled past in one
// folder stays read everywhere it appears.
model ReadFeedItem {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId String
  item   FeedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  readAt DateTime @default(now())

  @@id([userId, itemId])
  @@index([userId])
}

model Bookmark {
  id         String   @id @default(cuid())
  folderId   String?
  folder     Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain     String
  name       String
  faviconUrl String
  color      String
  position      Int
  feedUrl       String?
  feedCheckedAt DateTime?
  feedLatestAt  DateTime?
  unreadCount   Int       @default(0)
  lastVisitedAt DateTime?
  // Pinned bookmarks surface in the sidebar's top pin grid. They keep their
  // folder membership — pinning is a view flag, not a move.
  pinned        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([folderId])
}

// Comments attach to an article by its canonical URL key, so the same thread
// shows whether the article lives in the reading list or the RSS feed. Threaded
// via parentId; only root comments (parentId == null) may set a title.
// visibility controls who can read it: public (everyone), friends (accepted
// friends), or private (author only).
model Comment {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleKey   String    // canonical URL key — the join across reading list + feed
  articleUrl   String    // original URL, kept for reference/linking
  articleTitle String    @default("")
  parentId     String?
  parent       Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[] @relation("CommentThread")
  title        String?   // root comments only
  body         String    // sanitized HTML from the rich editor
  // 'public' (every signed-in user) | 'friends' (accepted friends) | 'private' (only the author)
  visibility   String    @default("private")
  // Set when the author deletes a comment that still has replies: the row is
  // kept as a tombstone (content wiped) so the thread below it survives. A
  // comment with no replies is hard-deleted instead, so this stays null.
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  revisions    CommentRevision[]

  @@index([articleKey])
  @@index([userId])
  @@index([parentId])
}

// A snapshot of a comment's content as it stood *before* an edit. One row is
// written each time an edit actually changes the title, body, or visibility, so
// the edit history can be reconstructed newest-first. editedAt is the moment the
// snapshot stopped being the live version (i.e. when the edit happened).
model CommentRevision {
  id         String   @id @default(cuid())
  commentId  String
  comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  title      String?
  body       String
  visibility String
  editedAt   DateTime @default(now())

  @@index([commentId])
}

// A blog post authored in the rich editor. Visibility mirrors Comment exactly —
// 'private' doubles as the draft state, so publishing is just widening it.
//
// The post carries its own canonical URL *and* the articleKey derived from it.
// That key is what Comment.articleKey threads on, so a post gets the whole
// comment system (threading, visibility, edit history) with no join table: a
// comment left on the post's page and one left on its card in an RSS folder
// land in the same thread. Both columns are stored rather than derived so that
// changing the deploy origin later can't orphan existing threads.
model BlogPost {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  slug            String   // "my-post-title" — unique per author, no date suffix
  body            String   // sanitized rich-editor HTML
  excerpt         String   @default("")  // plain-text summary for cards and RSS
  // Cover image, as a site-relative /api/v1/images/<id> path (see imagePathFor).
  // "" means none. Stored relative for the same reason embedded images are: it
  // survives the dev origin, a LAN address and the public domain unchanged.
  heroImage       String   @default("")
  // 'public' (anyone, incl. logged-out) | 'friends' (accepted friends) | 'private' (author only)
  visibility      String   @default("private")
  commentsEnabled Boolean  @default(true)
  url             String   // absolute canonical URL
  articleKey      String   @unique       // canonicalArticleKey(url) — joins to Comment
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, slug])
  @@index([userId, publishedAt])
  @@index([visibility, publishedAt])
}

// An image embedded in a note, comment or blog post. Bytes live in the database
// rather than on disk because the server container has no persistent volume (see
// docker-compose.yml) — only postgres does, so this is the one store that
// survives a rebuild and travels in a pg_dump backup.
//
// The id is the whole access control: the serve route is unauthenticated, because
// an image can be embedded in a public post read by logged-out visitors, and
// there is no way to know from the bytes alone which post is asking. A random
// cuid is treated as a bearer capability — unguessable, and never listed to
// anyone but its owner.
model Image {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Sniffed from the file's magic number on upload, never taken from the client
  mime      String
  data      Bytes
  size      Int      // bytes, denormalised so quota sums don't read the blobs
  width     Int
  height    Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A shelf in one person's Library. Deliberately parallel to Folder (the
// bookmark one) rather than shared with it: the two organise different objects
// and a bookmark folder carries feed subscriptions and a background image that
// mean nothing to a saved article.
//
// Library folders are self-only. Nothing here is exposed on the public profile,
// so there is no visibility column — the absence of one is the guarantee.
model ReadingFolder {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String
  position  Int
  items     ReadingListItem[]
  createdAt DateTime          @default(now())

  @@index([userId])
}

model ReadingListItem {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url      String
  title    String
  source   String
  readTime String
  tag      String
  notes    String   @default("")
  imageUrl String   @default("")
  // Moved out of the active reading list and into the Library. Was named
  // `archived` until the Library replaced the archive drawer.
  inLibrary Boolean @default(false)
  // Which Library shelf this sits on. Null is a real state, not a missing
  // value: it means Unsorted. Deleting a folder nulls this rather than
  // cascading, so losing a shelf never loses the articles on it.
  folderId String?
  folder   ReadingFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  savedAt  DateTime @default(now())

  @@index([userId])
  @@index([folderId])
}

// An append-only record of what an admin did to somebody else's account or
// content. The pino log already carried some of this, but a log file isn't
// queryable and two of the five moderation endpoints never wrote to it at all.
//
// Three deliberate choices, all following from the same fact — this table exists
// to outlive the things it describes:
//
//  1. `targetId` is a bare string with no foreign key. Most rows here record a
//     deletion, so the target is already gone; a real relation would either
//     block the delete or cascade the audit row away with it, which is exactly
//     backwards. `targetLabel` carries the human-readable identity instead,
//     captured before the action ran.
//
//  2. `actorId` is nullable and set null on delete, paired with a denormalised
//     `actorUsername`. Deleting an admin must not erase the record of what they
//     did while they held the role.
//
//  3. Nothing updates or deletes these rows, and no route offers to. Immutability
//     is by convention rather than a database rule, which is the right weight for
//     a single-instance deployment.
model AdminAction {
  id            String   @id @default(cuid())

  actorId       String?
  actor         User?    @relation("AdminActionActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorUsername String

  // Dotted verb from ADMIN_ACTIONS in lib/adminAudit.ts, e.g. 'user.ban'
  action        String

  targetType    String   // 'comment' | 'blogPost' | 'user'
  targetId      String
  targetLabel   String

  // Whatever makes the row legible later without the target: a before/after
  // visibility pair, a comment snippet, the counts a cascade destroyed.
  metadata      Json?

  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}
