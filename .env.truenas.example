# ─────────────────────────────────────────────────────────────────────────────
# Production env for TrueNAS deployment (docker-compose.truenas.yml).
# Copy to ".env" in the same directory as the compose file and fill in.
# The real .env is gitignored — never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── GHCR image source ──────────────────────────────────────────────────────────
# GitHub username/org that owns the pushed images, and the tag to run.
GHCR_OWNER=danieltucker
IMAGE_TAG=latest

# ── Database ───────────────────────────────────────────────────────────────────
# Strong random password.  Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
# TrueNAS dataset path that will hold the Postgres data (create the dataset first).
# No quotes even if the path contains spaces — Compose reads this file literally,
# taking the value to the end of the line, so quotes would become part of the path.
PGDATA_HOST_PATH=/mnt/Core Storage/Containers/newt/pgdata

# ── JWT secrets (REQUIRED — server refuses to start in prod without them) ───────
# Generate each separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_HEX

# Encrypts the LLM API keys users connect in Settings → AI. Required.
# Generate with: openssl rand -base64 32
# Back it up with the JWT secrets — if it changes, every stored key becomes
# undecryptable and each user has to paste theirs in again.
LLM_KEY_SECRET=CHANGE_ME_RANDOM_BASE64_32_BYTES

# ── HTTPS / reverse proxy ──────────────────────────────────────────────────────
# Exact public URL users visit (scheme + host, no trailing slash). Must match for CORS.
CLIENT_ORIGIN=https://newtab.yourdomain.com
# Keep true — you are serving over HTTPS. Auth cookies require this.
COOKIE_SECURE=true
# Proxy hops in front of the server so rate limiting keys on the real client IP.
# Your reverse proxy + the client nginx = 2. (Cloudflare Tunnel etc. may differ.)
TRUST_PROXY=2

# ── Host port ──────────────────────────────────────────────────────────────────
# The client (nginx) is published here; point your reverse proxy at truenas-ip:APP_PORT.
# Do NOT use 80/443 (TrueNAS web UI). 30000+ is a safe range.
APP_PORT=30080

# ── Feature flags ──────────────────────────────────────────────────────────────
# Close signups after creating your account(s).
REGISTRATION_ENABLED=true
# Console ping/tracert endpoints — keep false on an internet-facing deployment.
CONSOLE_ENABLED=false

# ── AI personas: which private hosts the site model may reach ──────────────────
# The endpoints themselves are configured in Admin → Personas → Models. THIS is
# the part that cannot live there, and the split is deliberate:
#
#   Changing which model answers is a preference, and belongs in a UI.
#   Letting the server open connections *inside your network* is a capability,
#   and stays gated on access to this file. A database row needs only an admin
#   web session; this needs the host.
#
# So the panel may name any endpoint. A public HTTPS one just works. A private
# one works only if its host is listed here — otherwise it is refused, with an
# error naming this variable.
#
# Comma-separated. Entries may be a hostname or a literal address, and you need
# whichever form you actually type into the panel:
#   - a compose service is reached by NAME (its container IP changes on recreate)
#   - a box on your LAN is usually typed as an ADDRESS
#
# Running Ollama alongside Newt (uncomment the service in the compose file):
#   OPERATOR_LLM_PRIVATE_HOSTS=ollama
# Pointing at a GPU machine on your LAN:
#   OPERATOR_LLM_PRIVATE_HOSTS=192.168.1.50
# Both, plus a public endpoint (which needs no entry at all):
#   OPERATOR_LLM_PRIVATE_HOSTS=ollama,192.168.1.50
OPERATOR_LLM_PRIVATE_HOSTS=

# ── Legacy single-endpoint config (still honoured) ─────────────────────────────
# How personas were configured before the admin panel existed. Used only as a
# fallback when no endpoint has been added there, so upgrading does not switch
# personas off. Its host is added to the allowlist above automatically.
# Prefer the panel for anything new; leave these blank on a fresh install.
OPERATOR_LLM_BASE_URL=
OPERATOR_LLM_MODEL=
OPERATOR_LLM_KEY=

# Dataset holding Ollama's model weights. Only needed if you uncomment the
# ollama service. Same no-quotes rule as PGDATA_HOST_PATH above.
# OLLAMA_HOST_PATH=/mnt/Core Storage/Containers/newt/ollama
