# ── Database ──────────────────────────────────────────────────────────────────
# Password for the PostgreSQL user. Use a strong random string.
POSTGRES_PASSWORD=changeme

# ── JWT secrets ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production — server refuses to start if these are missing.
JWT_ACCESS_SECRET=replace-with-random-64-char-hex
JWT_REFRESH_SECRET=replace-with-different-random-64-char-hex

# ── AI features ───────────────────────────────────────────────────────────────
# Encrypts the LLM API keys users connect in Settings → AI. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REQUIRED in production — the server refuses to start without it.
#
# Treat it like the JWT secrets: back it up, and do not rotate it casually.
# Changing it does not corrupt anything, but every stored key becomes
# undecryptable and every user has to paste theirs in again.
LLM_KEY_SECRET=replace-with-random-base64-32-bytes

# ── Client ────────────────────────────────────────────────────────────────────
# Port to expose the web UI on (default: 80)
APP_PORT=80

# The URL users access the app at. Must match exactly for CORS.
# Examples: http://192.168.1.100, https://newtab.yourdomain.com
CLIENT_ORIGIN=http://localhost

# ── Cookies ───────────────────────────────────────────────────────────────────
# Set to false when running over plain HTTP (local network without TLS).
# Set to true (or omit) when behind an HTTPS reverse proxy — required for production.
COOKIE_SECURE=true

# ── Proxy / rate limiting ─────────────────────────────────────────────────────
# Number of proxy hops in front of the server, so per-IP rate limiting sees the
# real client IP. Leave UNSET for `npm run dev` (direct connection). Set to 1 for
# the local docker-compose stack (client nginx), or 2 behind a reverse proxy + nginx.
# TRUST_PROXY=2

# ── Registration ──────────────────────────────────────────────────────────────
# Set to false to close registration (existing users can still log in).
# Recommended once you have created your account(s) on a public-facing server.
REGISTRATION_ENABLED=true

# ── Console features ──────────────────────────────────────────────────────────
# Set to false to disable the ping/tracert endpoints entirely.
# Recommended if you don't use the built-in network console widget.
CONSOLE_ENABLED=true

# ── First admin ───────────────────────────────────────────────────────────────
# One-time bootstrap secret. While the instance has zero admins, any signed-in
# user can claim admin from Settings → Account by entering this. Once an admin
# exists the token is inert — manage further admins from the admin panel.
# The alternative is: npm run make-admin --workspace=server -- <username>
# Generate with: openssl rand -hex 24
# ADMIN_SETUP_TOKEN=

# ── Crawlers ──────────────────────────────────────────────────────────────────
# Model-training and AI-answer crawlers (GPTBot, ClaudeBot, CCBot, …), as
# robots.txt will report them. Denying is reversible and allowing is not,
# which is the only reason deny is the default rather than a position.
AI_CRAWLERS=deny

# ── Public address ────────────────────────────────────────────────────────────
# The address strangers type in, when it differs from CLIENT_ORIGIN. It is what
# share links and your outgoing RSS point at. Falls back to CLIENT_ORIGIN.
# PUBLIC_ORIGIN=https://newt.example.com

# ── The instance’s own model (optional) ───────────────────────────────────────
# Which private hosts the site model behind Admin → AI may reach. Endpoints are
# added in the panel; being allowed to open a connection inside your network is
# a capability, so it stays here, where changing it needs the host rather than
# an admin web session. Comma-separated hostnames or addresses; blank means the
# panel accepts only public endpoints.
# OPERATOR_LLM_PRIVATE_HOSTS=ollama,192.168.1.50

# Pre-panel single-endpoint config, still honoured as a fallback when no
# endpoint has been added in Admin → AI → Models.
# OPERATOR_LLM_BASE_URL=
# OPERATOR_LLM_MODEL=
# OPERATOR_LLM_KEY=

# ── Background workers ────────────────────────────────────────────────────────
# The feed poller and the AI job queue. Set either to false to switch it off —
# what you want on a second instance sharing one database.
# FEED_SCHEDULER=false
# AI_QUEUE=false
