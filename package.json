{
  "name": "newtab-root",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=client && npm run test --workspace=server",
    "csp:hash": "node scripts/csp-hash.mjs",
    "shots": "node scripts/shots.mjs",
    "marketing:check": "node scripts/marketing-check.mjs",
    "check:html": "node scripts/check-html.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright": "^1.61.1"
  },
  "allowScripts": {
    "@prisma/client@7.8.0": true,
    "sharp@0.33.5": true,
    "esbuild@0.21.5": true,
    "prisma@7.8.0": true,
    "@prisma/engines@7.8.0": true
  }
}
